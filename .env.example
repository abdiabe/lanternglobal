# Copy to .env.local for local development, and set the same variables in your
# hosting provider for production. Never commit real values.

# --- Site ---------------------------------------------------------------
# Production URL, no trailing slash. Used for canonical URLs, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.lanternglobal.com
# Set to "false" on preview/staging deployments so they are not indexed.
NEXT_PUBLIC_ALLOW_INDEXING=true
# Optional public booking page (Calendly, Cal.com, HubSpot Meetings).
# When unset, "Schedule a Consultation" routes to the inquiry form.
NEXT_PUBLIC_SCHEDULING_URL=

# --- Form delivery (server-only) ------------------------------------------
# Forms refuse submissions with a clear message until at least one channel is configured.
# Email via Resend (https://resend.com). The from-address domain must be verified in Resend.
RESEND_API_KEY=
FORMS_FROM_EMAIL=Lantern Global Website <forms@your-verified-domain.com>
# Comma-separated recipients for client inquiries and contact messages.
INQUIRY_TO_EMAIL=
# Recipients for job applications (falls back to INQUIRY_TO_EMAIL).
CAREERS_TO_EMAIL=

# Optional CRM / automation webhook for inquiries and contact messages
# (HubSpot workflow, Zapier, Make, n8n). Applications are never sent here.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=

# --- Spam protection (optional) -------------------------------------------
# Cloudflare Turnstile. Honeypot, timing, and rate limits are always active.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Testing only ---------------------------------------------------------
# Points email delivery at a mock server in automated tests. Leave unset in production.
RESEND_API_BASE=
